{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "DockPanel Desktop",
  "version": "0.1.0",
  "identifier": "com.dockpanel.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../../panel/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DockPanel Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http://asset.localhost; connect-src 'self' http://127.0.0.1:8080 http://localhost:8080 https://127.0.0.1:8080 https://localhost:8080 ws://127.0.0.1:8080 ws://localhost:8080; img-src 'self' asset: http://asset.localhost data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
